# Shaivika IT Technologies - Safe Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL
# Configure these securely in Netlify Site Settings: Site configuration -> Environment variables

# 1. Administrator Authentication (Netlify Functions)
ADMIN_USERNAME=shaivika_admin
# PBKDF2 Password Salt & Hash (generate via admin auth change password or setup script)
ADMIN_PASSWORD_SALT=your_random_64char_hex_salt_here
ADMIN_PASSWORD_HASH=your_pbkdf2_sha512_hash_here
# Cryptographic secret for signing HMAC-SHA256 session tokens (minimum 64 characters recommended)
ADMIN_JWT_SECRET=your_long_random_cryptographic_jwt_secret_here

# 2. Google Apps Script Dedicated WebApp Integrations
CONTACT_GAS_URL=https://script.google.com/macros/s/your_contact_webapp_id/exec
PORTFOLIO_GAS_URL=https://script.google.com/macros/s/your_portfolio_webapp_id/exec
SUBSCRIBERS_GAS_URL=https://script.google.com/macros/s/your_subscribers_webapp_id/exec
INVOICE_GAS_URL=https://script.google.com/macros/s/your_invoice_webapp_id/exec
GAS_API_KEY=your_google_apps_script_shared_api_key_here

# 3. n8n AI Chatbot Webhook Endpoint
N8N_CHAT_WEBHOOK=https://n8n.shaivikamanojkumarcloud.me/webhook/shaivika-ai-chat

# 4. CORS & Domain Restrictions (Optional - defaults to shaivikaittechnologies.in)
ALLOWED_ORIGIN=https://shaivikaittechnologies.in
